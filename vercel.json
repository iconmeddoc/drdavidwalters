{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "drdavidwalters.vercel.app"
        }
      ],
      "destination": "https://drdavidwalters.com/:path*",
      "permanent": true
    },
    {
      "source": "/thebook",
      "destination": "/book",
      "permanent": true
    },
    {
      "source": "/launchteam",
      "destination": "https://drdavidwalters.eo.page/launchteam",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/go/:channel",
      "destination": "/book"
    }
  ]
}